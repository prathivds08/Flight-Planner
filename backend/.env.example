# ── Flight Planner Backend ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# AirLabs API key (https://airlabs.co/ — free tier: 1,000 req/month)
# Leave blank to use mock data from flights.csv
AIRLABS_API_KEY=

# Force mock data even when an API key is set (true / false)
USE_MOCK_DATA=true

# Allowed frontend origins (JSON array)
CORS_ORIGINS=["http://localhost:3000"]
